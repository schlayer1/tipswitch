rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Voller Lese- und Schreibzugriff auf die Praktikumsberichte (Tag in der Praxis)
    match /reports/{reportId} {
      allow read, write: if true;
    }

    // Voller Lese- und Schreibzugriff auf die Projektkompass-Boards
    match /projektkompass_boards/{boardId} {
      allow read, write: if true;
    }

    // TIP Matching (TipSwitch) - Betriebe & Stellen
    match /tip_companies/{companyId} {
      allow read, write: if true;
    }

    // TIP Matching (TipSwitch) - Schüler-Wünsche (Likes & Superlikes)
    match /tip_student_preferences/{studentCode} {
      allow read, write: if true;
    }

  }
}
